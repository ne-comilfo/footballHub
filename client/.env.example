# own — данные из своей БД, external — из внешних API
DATA_SOURCE=own
OWN_API_URL=http://localhost:5000

# одинаковый с серверным, минимум 32 символа
JWT_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# живые матчи идут сюда даже в режиме own
THE_SPORTS_DB_BASE_URL=https://www.thesportsdb.com/api/v1/json

# нужны только при DATA_SOURCE=external
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
FOOTBALL_SEASON=2024
